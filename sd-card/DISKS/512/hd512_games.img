2970 PRINT "'YES' OR 'NO' OR 'AUTO'( GIVES A SUMMARY EVERY FIVE TURNS"
2980 PRINT "AND DOESN'T ASK YOU ANY MORE"
2990 GOTO 2850
3000 GOTO 3010
3010 FOR J8=1 TO N
3020 X=0
3030 T0=0
3040 IF Q(J8)=1 THEN3650
3050 T$=" "
3060 IF A(J8)=1 THEN 3120
3070 IF N$(J8)<>"ME" THEN 3100
3080 PRINT "YOU HAVE $";T(J8);
